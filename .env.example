PUBLIC_URL=http://localhost:3000
PROD_PUBLIC_URL=http://playbook-workflow-builder.cloud
DEV_PUBLIC_URL=http://dev.playbook-workflow-builder.cloud
PYTHON_BIN=python3
PYTHON_ROOT=
STRICT_TS=true
N_WORKERS=5

# Production deployment

# File storage (see docs/production.md), files are stored in data/ufs by default
#STORAGE_PATH=
# or in an S3 (compatible) bucket, credentials come from the standard AWS_* variables
#S3_BUCKET=
#S3_PREFIX=
#S3_ENDPOINT=
#S3_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# in production /graph/extend is a better landing page
LANDING_PAGE=/sitemap
#LANDING_PAGE=/graph/extend

# make this 1 to deploy an ingress after configuring other variables
DEPLOY_INGRESS=0
#SERVER_NAME=localhost
#LETSENCRYPT_EMAIL=

#EMAIL_SERVER=smtp://user:pass@email.com:587
#EMAIL_FROM=playbook-partnership@maayanlab.cloud
#BETTER_AUTH_SECRET=
#BETTER_AUTH_GOOGLE={"clientId":"","clientSecret":""}
#BETTER_AUTH_ORCID={"clientId":"","clientSecret":""}
#BETTER_AUTH_KEYCLOAK='{"issuer":"https://auth.cfde.cloud/realms/cfde","clientId":"your_client_id","clientSecret":"your_client_secret"}'

# database
#POSTGRES_DB=db
#POSTGRES_USER=user
#POSTGRES_PASSWORD=pass
# postgres (production, migrate with `npm run db:migrate`) or sqlite (migrated automatically)
#  when unset, an in-memory sqlite database is used
#DATABASE_URL=postgres://user:pass@host/db
#DATABASE_URL=sqlite:data/pwb.sqlite

# analytics

# google
#NEXT_PUBLIC_GA_MEASUREMENT_ID=
# matomo
#NEXT_PUBLIC_MATOMO_URL=
#NEXT_PUBLIC_MATOMO_SITE_ID=

#chatGPT
#OPENAI_API_KEY=
#OPENAI_MODEL=

# FASTQ
ELYSIUM_USERNAME=
ELYSIUM_PASSWORD=
