    "events": "^3.3.0",
    "jwt-decode": "^3.1.2",
    "multiparty": "^4.2.3",
    "next": "^14.1.0",
    "nodemailer": "^8.0.11",
    "prismjs": "^1.29.0",
    "puppeteer": "^25.16.0",
    "raw-body": "^2.5.2",
    "react-markdown": "^8.0.6",
    "react-masonry-css": "^1.0.16",
    "react-simple-code-editor": "^0.13.1",
    "sharp": "^0.32.6",
    "use-async-effect": "^2.2.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.0",
