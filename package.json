{
  "name": "playbook-workflow-builder",
  "version": "0.81.5",
  "description": "A repository for the playbook workflow builder collaboration.",
  "private": true,
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "./app",
    "./components/**"
  ],
  "bin": {
    "pwb": "cli/pwb.ts"
  },
  "scripts": {
    "build": "npm --workspace=app run build",
    "codegen:citations": "tsx --env-file-if-exists=.env cli/build-citations.ts",
    "codegen:components": "tsx --env-file-if-exists=.env cli/sync-component-import.ts",
    "codegen:icons": "python cli/convert-icons.py icons/services/src icons/services/index.ts",
    "codegen:requirements": "tsx --env-file-if-exists=.env cli/enumerate-requirements.ts",
    "codegen:table": "tsx --env-file-if-exists=.env cli/build-table.ts > metanodes.tsv",
    "codegen:use-case-table": "tsx --env-file-if-exists=.env cli/build-use-case-table.ts > use-cases.tsv",
    "codegen:analytics": "tsx --env-file-if-exists=.env cli/dump-analytics.ts > analytics.tsv",
    "db:migrate": "tsx --env-file-if-exists=.env cli/migrate.ts",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 npm run --workspace=app dev",
    "start:worker": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_ENV=production APP_ROOT=$(pwd) tsx --env-file-if-exists=.env cli/resolve-process-worker.ts",
    "start:run-wes-worker": "tsx --env-file-if-exists=.env cli/run-wes-worker.ts",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 npm run --workspace=app start",
    "version": "tsx --env-file-if-exists=.env cli/version-compose.ts && git add docker-compose.yaml && docker-compose build --parallel",
    "postversion": "docker-compose push",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@blueprintjs/core": "^6.22.0",
    "@blueprintjs/icons": "^6.15.0",
    "@blueprintjs/select": "^6.4.1",
    "@blueprintjs/table": "^6.3.1",
    "@mdi/js": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.26.0",
    "@trpc/server": "^11.26.0",
    "@trpc/tanstack-react-query": "^11.26.0",
    "@types/pluralize": "^0.0.33",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.0.3",
    "classnames": "^2.5.1",
    "cmd-ts": "^0.15.0",
    "eventsource": "^5.1.5",
    "fast-sha256": "^1.3.0",
    "form-data": "^4.0.6",
    "glob": "^14.0.4",
    "json-canonicalize": "^3.0.1",
    "jsonld": "^9.0.0",
    "jszip": "^3.10.2",
    "kysely": "^0.29.8",
    "openai": "^7.54.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pg-listen": "^1.7.0",
    "pluralize": "^8.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "trpc-to-openapi": "^3.5.0",
    "ts-dedent": "^2.3.0",
    "tsx": "^4.23.15",
    "yaml": "^2.4.2",
    "zod": "^4.6.7",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/glob": "^8.1.0",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.6",
    "ssl-proxy": "^1.0.3",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "react-supervenn": {
      "react": "$react"
    }
  }
}
